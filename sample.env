# plm — copy to .env (`cp sample.env .env`); every line is optional, and you
# need none of them to run plm. docker-compose.yml has a working default for
# each; uncomment to override.

# --- addresses ---------------------------------------------------------------
# Interface the three ports bind on. 127.0.0.1 = this machine only;
# 0.0.0.0 = your network (then read "Auth modes" in DEPLOY.md first).
#PLM_BIND=127.0.0.1
#PLM_PORT=8097            # web UI + API
#PLM_MCP_PORT=8098        # MCP server, http://localhost:8098/mcp
#PLM_GIT_PORT=8092        # git clone/push, http://localhost:8092/git/<N>.git
# Where people and agents reach plm — every link plm prints is built on these.
# Defaults follow the ports above on localhost; set both behind a hostname/proxy.
#PLM_PUBLIC_URL=http://localhost:8097
#PLM_GIT_CLONE_BASE=http://localhost:8092/git

# --- who owns ./data, who is admin ------------------------------------------
# The uid:gid the services run as and that owns ./data. Linux: set to `id -u`
# and `id -g` BEFORE the first `up` when they are not 1000 (Docker Desktop on
# macOS/Windows maps ownership itself; leave them).
#PLM_UID=1000
#PLM_GID=1000
# The first admin (approver), seeded on first start; the first token's name.
#PLM_ADMIN=admin

# --- git-first ---------------------------------------------------------------
# off | read | write — the instance default; per project: python -m plm.gitmode
#PLM_GIT_MODE=write

# --- auth (DEPLOY.md § Auth modes) --------------------------------------------
# trusted-network: the network is the boundary, tokens say who. required: every
# write needs a token or an OIDC login — use it for anything others can reach.
#PLM_AUTH_MODE=trusted-network
#OIDC_ISSUER=https://id.example.com
#OIDC_CLIENT_ID=plm
# client secret: put it in data/secrets/oidc-client-secret (never in this file)
#OIDC_REDIRECT_URI=http://localhost:8097/auth/callback
#OIDC_ACCESS_GROUP=plm-users,admins

# --- odds and ends ------------------------------------------------------------
# Hosts an integration may POST to (comma-separated; empty = any).
#PLM_ACTIONS_ALLOW_HOSTS=
# One line agents are told about reporting bugs (empty = "tell the operator").
#PLM_ISSUES_ADVICE=File plm bugs at https://example.com/issues
# Image tag the build produces, and the compose stack's name.
#PLM_IMAGE=plm-selfhost:latest
#COMPOSE_PROJECT_NAME=plm
