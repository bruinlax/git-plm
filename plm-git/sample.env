# plm-git — sample.env. Copy to .env and edit. .env is gitignored.
# Every value below has a working default; this file documents ALL of them.
# Host-agnosticism rule: hostnames, paths and ports appear HERE and nowhere else.

# --- the vault (READ-ONLY to plm-git) ---
# The one git repo that is the CAD system of record.
#PLMGIT_VAULT=/vault

# --- local cache: mirror clone + generated per-part bare repos ---
# MUST be local disk. Never point this at a network-synced
# volume — syncing corrupts git object stores.
#PLMGIT_CACHE=~/.cache/plm-git

# --- plm proper, the identity authority (number -> items.folder) ---
# From the host:       http://127.0.0.1:8097
# From the container:  http://plm:8097  (we join plm's own compose network)
#PLMGIT_PLM_URL=http://plm:8097
# The external docker network to join. Must be the one plm's container is on;
# `docker inspect plm -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'`
#PLMGIT_PLM_NETWORK=plm_default

# Fallback resolver, used only when the API above is unreachable. Opened
# mode=ro; plm-git can never write to plm's registry.
#PLMGIT_DB_DIR=~/.cache/plm
#PLMGIT_DB=~/.cache/plm/plm.sqlite3

# --- exposure ---
#PLMGIT_BIND=0.0.0.0
#PLMGIT_PORT=8099

# uid:gid that owns the CAD repo and the cache (compose `user:`), so the cache
# stays readable from a host shell.
#PLMGIT_UID=1027
#PLMGIT_GID=100

# --- behaviour ---
# Seconds to trust a just-checked part without re-fetching the vault. One clone
# makes several requests; only the ref advertisement should cost a vault fetch.
#PLMGIT_FRESHNESS_TTL=30

# Branch name inside each generated per-part repo.
#PLMGIT_BRANCH=main

# =========================================================================
# THE WRITE PATH — `git push` == "propose a revision"
# =========================================================================
# Off by default, everywhere. With this at 0 the router refuses every
# receive-pack request AND every generated repo carries http.receivepack=false,
# so a push cannot land for two independent reasons.
#
# The `plm-git-sandbox` compose service sets this to 1 against plm-sandbox.
# Turning it on for the SYSTEM OF RECORD is a three-step, deliberate act — see
# "Enabling push against prod" in README.md.
#PLMGIT_ALLOW_PUSH=0

# WHICH plm receives the DRAFT revisions. Reads use PLMGIT_PLM_URL; writes use
# this, and it defaults to the sandbox because a mistake here is a commit in
# your system of record.
#PLMGIT_PUSH_PLM_URL=http://plm-sandbox:8097

# Second lock: a target that does not look like a sandbox is refused at the door
# unless this also says yes. Two flags, on purpose.
#PLMGIT_PUSH_ALLOW_PROD=0

# Identity. A push must be attributable — plm records the pusher as the DRAFT's
# author. Lines of `<token>=<plm username>`; the username must already exist in
# plm (GET /api/users) and hold the `editor` role. Use the FILE form so the
# secret is not visible in `docker inspect`:
#     mkdir -p ~/.config/plm-git
#     printf '%s=agent\n' "$(openssl rand -hex 24)" > ~/.config/plm-git/sandbox-tokens
#     chmod 600 ~/.config/plm-git/sandbox-tokens
#PLMGIT_PUSH_TOKENS_FILE=/run/plm-git/tokens
#PLMGIT_TOKENS_FILE=~/.config/plm-git/sandbox-tokens
# (inline alternative, for a throwaway: PLMGIT_PUSH_TOKENS=tok1=agent,tok2=alice)

# The ref a proposal is pushed to. Gerrit's convention, which every model already
# knows. refs/heads/* is ALWAYS refused: the served branch is plm's projection of
# the vault, not a place to push.
#PLMGIT_PUSH_REF=refs/for/main

# What submit_for_release aims at. plm's approver still decides.
#PLMGIT_PUSH_TARGET_STATE=PROTOTYPE

# Size sanity, checked in pre-receive where saying no is cheap.
#PLMGIT_PUSH_MAX_FILE_BYTES=201326592     # 192 MiB, = plm's PLM_RAW_UPLOAD_MAX
#PLMGIT_PUSH_MAX_TOTAL_BYTES=268435456    # 256 MiB per push
#PLMGIT_PUSH_MAX_FILES=200

# How binaries reach plm — an explicit choice, no automatic fallback.
# `staged` = plm mints an upload in its own inbox, plm-git PUTs the bytes there
# (POST /api/uploads, PUT /api/uploads/<token>) and hands over the handle.
# `raw` = PUT each binary straight onto the DRAFT (/api/items/<n>/files/<name>).
# Either way bytes never ride a JSON body.
#PLMGIT_PUSH_BINARY_TRANSPORT=staged

# Which extensions travel inline as text (everything else is a binary by
# reference). Mirrors plm's PLM_BLOBSTORE_PIN_EXT.
#PLMGIT_PUSH_TEXT_EXT=.scad .md .txt .csv .json .toml .yaml .yml .ini .py .cfg .gitignore .sha256 .gcode .svg

# --- the sandbox instance (docker-compose.yml `plm-git-sandbox`) ---
#PLMGIT_SANDBOX_PLM_URL=http://plm-sandbox:8097
#PLMGIT_SANDBOX_VAULT=/srv/plm/sandbox/vault
#PLMGIT_SANDBOX_DB_DIR=/srv/plm/sandbox/db
#PLMGIT_SANDBOX_CACHE=~/.cache/plm-git-sandbox
#PLMGIT_SANDBOX_PORT=8199
#PLMGIT_CODE_DIR=/path/to/git-plm/plm-git
