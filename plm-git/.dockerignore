# Build context = what gets shipped to the docker daemon. On a network-synced
# volume every byte here is read over the network, so a stray .venv/ can make
# builds take ~20 MINUTES instead of 30 SECONDS. Keep this file honest.
.git
.gitignore
.venv
venv
env
node_modules
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.env
.env.*
!.env.example
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.log
.DS_Store
